{
  "name": "@openploy/agent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "bootstrap:platform-domain": "tsx src/scripts/bootstrap-platform-domain.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openploy/compose": "workspace:*",
    "@openploy/crypto": "workspace:*",
    "@openploy/db": "workspace:*",
    "@openploy/docker": "workspace:*",
    "@openploy/github": "workspace:*",
    "@openploy/notifications": "workspace:*",
    "@openploy/queue": "workspace:*",
    "@openploy/shared": "workspace:*",
    "@openploy/storage": "workspace:*",
    "@openploy/traefik": "workspace:*",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
