# Platform Postgres (metadata only, never user-deployed databases)
DATABASE_URL=postgres://openploy:openploy@localhost:5432/openploy
DATABASE_POOL_MAX=10

# Envelope-encryption master key, base64-encoded 32 bytes. The installer
# generates this and writes it to /etc/openploy/master.key (0600) in production;
# for local dev generate one with: openssl rand -base64 32
OPENPLOY_MASTER_KEY=
OPENPLOY_MASTER_KEY_VERSION=1

NODE_ENV=development

# Public base URL of this instance, used to build the GitHub App manifest
# (webhook URL, redirect URL) - must be reachable from GitHub's servers,
# so a local dev instance needs a tunnel (e.g. ngrok) for the GitHub flows to work.
APP_BASE_URL=http://localhost:3000
